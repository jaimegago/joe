# Binaries (anchored to the repo root so the rule does not also match
# `cmd/joe/*.go` and the `cmd/joe-core/` package — an unanchored `joe`
# pattern matches the directory segment at any depth, which silently
# untracked every Go source file under cmd/joe/).
/joe
/joecored
/joe-mcp
/joe-security
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Go workspace file
go.work.sum

# Dependency directories
vendor/

# Build cache
/dist/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Joe runtime data (local dev)
~/.joe/

# Claude
.claude/
