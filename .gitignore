# Binaries (anchored to the repo root so the rule does not also match
# `cmd/joe/*.go` — an unanchored `joe` pattern matches the directory
# segment at any depth, which silently untracked every Go source file
# under cmd/joe/).
/joe
/joecored
/joe-mcp
/joe-security
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Go workspace file
go.work.sum

# Dependency directories
vendor/

# Build cache
/dist/

# Embedded web UI build output. `make build-ui` stages the real Vite build
# (index.html, vite.svg, hashed assets/*) into internal/webui/dist; none of it
# is committed. Only the .gitkeep placeholder stays tracked so the go:embed
# directive matches in a fresh checkout.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# macOS
.DS_Store
._*

# Windows
Thumbs.db
Desktop.ini

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.sublime-workspace
*.sublime-project

# Joe runtime data (local dev)
~/.joe/

# Claude
.claude/

# Personal project-knowledge doc (pinned as claude.ai Project knowledge, not for publish)
/JOE_PROJECT_KNOWLEDGE.md
